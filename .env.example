# PostgreSQL connection URL for svc-workflow
# ⚠️ 部署前必须修改 POSTGRES_PASSWORD
# 开发环境：postgres://postgres:postgres@localhost:5432/svc_workflow
# 生产环境：postgres://postgres:<CHANGE_ME-strong-password>@localhost:5432/svc_workflow
DATABASE_URL=postgres://${POSTGRES_USER:-postgres}:${POSTGRES_PASSWORD:-postgres}@localhost:5432/${POSTGRES_DB:-svc_workflow}
